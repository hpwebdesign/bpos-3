<?xml version="1.0" encoding="utf-8"?>
<modification>
    <name>Barik Point Of Sales</name>
    <code>BPOS</code>
    <version>1.0.0.5</version>
    <author>HP Web Design</author>
    <link>https://bariklabs.com</link>

    <!-- Admin menu: inside the shared $hpwd group when system.ocmod.xml provides it -->
    <file path="admin/controller/common/column_left.php">
        <operation error="skip">
            <search><![CDATA[$hpwd = array();]]></search>
            <add position="after"><![CDATA[
                    // BPOS
                    if ($this->user->hasPermission('access', 'extension/module/bpos')) {
                        $hpwd[] = array(
                            'name'     => 'Barik POS',
                            'href'     => $this->url->link('extension/module/bpos', 'user_token=' . $this->session->data['user_token'], true),
                            'children' => array()
                        );
                    }
                    // BPOS
            ]]></add>
        </operation>
        <!-- Fallback: own top-level menu when the shared $hpwd group is not there -->
        <operation error="skip">
            <ignoreif><![CDATA[$hpwd = array();]]></ignoreif>
            <search><![CDATA[// Stats]]></search>
            <add position="before"><![CDATA[
			// BPOS
			if ($this->user->hasPermission('access', 'extension/module/bpos')) {
				$data['menus'][] = array(
					'id'       => 'menu-bpos',
					'icon'     => 'fa-shopping-cart',
					'name'     => 'Barik POS',
					'href'     => $this->url->link('extension/module/bpos', 'user_token=' . $this->session->data['user_token'], true),
					'children' => array()
				);
			}
			// BPOS
            ]]></add>
        </operation>
    </file>

    <!-- Header link to the BPOS settings page: only for users who may open it -->
    <file path="admin/controller/common/header.php">
        <operation error="skip">
            <search><![CDATA[$data['profile'] = $this->url->link('common/profile']]></search>
            <add position="after"><![CDATA[
			// BPOS
			$data['pos_menu'] = $this->user->hasPermission('access', 'extension/module/bpos');
			$data['pos_setting'] = $this->url->link('extension/module/bpos', 'user_token=' . $this->session->data['user_token'], true);
			// BPOS
            ]]></add>
        </operation>
    </file>
    <file path="admin/view/template/common/header.twig">
        <operation error="skip">
            <search><![CDATA[<ul class="nav navbar-nav navbar-right">]]></search>
            <add position="after"><![CDATA[
      {% if pos_menu %}
      <li><a href="{{ pos_setting }}"><span style="display:inline-block;width:30px;height:30px;line-height:30px;padding:0 10px;border-radius:4px;background:linear-gradient(135deg,#6aa8ff,#2a6cf6);color:#fff;font-weight:800;">B</span> <span>POS</span></a></li>
      {% endif %}
            ]]></add>
        </operation>
    </file>
</modification>
