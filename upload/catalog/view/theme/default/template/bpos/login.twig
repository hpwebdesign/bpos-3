      <polygon points="832,702 852,702 866,744 842,754 826,740" fill="#8590cf"/>
      <rect x="778" y="746" width="66" height="10" rx="5" fill="#5f6aae"/>
      <rect x="712" y="698" width="74" height="12" rx="6" fill="#2a3070"/>
      <path d="M850 744 L862 770" stroke="#333a7a" stroke-width="6" stroke-linecap="round"/>
      <path d="M846 706 L836 660" stroke="#333a7a" stroke-width="5" stroke-linecap="round"/>
      <rect x="822" y="652" width="30" height="7" rx="3.5" fill="#333a7a"/>
      <rect x="664" y="716" width="6" height="14" rx="2" fill="#D98A7A" class="tail"/>
      <circle cx="868" cy="690" r="6" fill="#FFF1C4" filter="url(#glow)"/>
      <!-- rider: faceless -->
      <path d="M766 708 L808 718 L802 752" stroke="#2a3070" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      <ellipse cx="806" cy="754" rx="13" ry="5" fill="#10143a"/>
      <path d="M756 704 Q752 672 772 646 L800 640 L818 658 Q800 690 790 706 Z" fill="#5560b8"/>
      <path d="M768 650 L798 644" stroke="#fff" stroke-width="4" opacity=".35" stroke-linecap="round"/>
      <path d="M804 650 L840 660" stroke="#5560b8" stroke-width="12" stroke-linecap="round"/>
      <circle cx="842" cy="659" r="6" fill="#1d2556"/>
      <circle cx="800" cy="614" r="21" fill="#c3caf2"/>
      <path d="M806 598 Q830 600 828 618 Q822 626 806 624 Z" fill="#1d2556"/>
      <path d="M812 604 Q822 605 823 612" stroke="#fff" stroke-width="2" opacity=".3" fill="none" stroke-linecap="round"/>
