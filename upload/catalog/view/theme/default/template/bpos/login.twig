</div>
<div class="page">
  <header class="top">
    <div class="bname"><span class="logo{% if logo_url %} img{% endif %}" id="logo">{% if logo_url %}<img src="{{ logo_url|e }}" alt="">{% else %}B{% endif %}</span><span>{{ brand|e }}<small>{{ text_tagline }}</small></span></div>
    <div class="tools">
      <button class="tbtn" id="lang" aria-label="{{ text_language|e }}"><i class="bi bi-translate"></i><span id="langTxt">{{ lang_label|e }}</span></button>
      <button class="tbtn" id="theme" aria-label="{{ text_theme|e }}"><i class="bi bi-moon-stars"></i></button>
    </div>
  </header>
  <div class="main">
    <section class="hero">
      <h1 id="heroH">{{ hero_head|e }}</h1>
      <p id="heroP">{{ hero_desc|e }}</p>
      <div class="spill"><i class="bi bi-shop"></i><span><b id="storeName" style="font-weight:inherit">{{ store_name|e }}</b>{% if terminal_hint %} <small>{{ terminal_hint|e }}</small>{% endif %}</span><span class="clock" id="clock">--:--<small id="date"></small></span></div>
    </section>
    <form class="card" id="card" novalidate autocomplete="on">
        <div>
          <h2>{{ text_sign_in }}</h2>
          <p class="sub">{{ text_sign_in_sub }}</p>
        </div>

        <div class="adm" id="adm"{% if not admin_name %} hidden{% endif %}>
          <i class="bi bi-shield-check"></i>
          <div><b>{{ text_admin_in }}</b><small id="admName">{{ admin_name|e }}</small></div>
          <button type="button" class="btn" id="admGo">{{ button_continue }}</button>
        </div>

        <div class="field">
          <label for="user">{{ entry_username }}</label>
          <div class="fld"><i class="bi bi-person"></i><input class="inp" id="user" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="{{ entry_username|e }}" required></div>
        </div>

        <div class="seg2" role="tablist" aria-label="{{ text_method|e }}">
          <button type="button" role="tab" id="mPw" class="on" aria-selected="true"><i class="bi bi-key"></i><span>{{ entry_password }}</span></button>
          <button type="button" role="tab" id="mPin" aria-selected="false"><i class="bi bi-grid-3x3-gap"></i><span>{{ entry_pin }}</span></button>
        </div>

        <div id="pwBox" class="field">
          <label for="pw">{{ entry_password }}</label>
          <div class="fld"><i class="bi bi-lock"></i><input class="inp" id="pw" name="password" type="password" autocomplete="current-password" placeholder="••••••••"><button type="button" class="eye" id="eye" aria-label="{{ js_show_pw|e }}"><i class="bi bi-eye"></i></button></div>
          <div class="hint" id="caps" hidden><i class="bi bi-capslock"></i><span>{{ text_caps }}</span></div>
        </div>

        <div id="pinBox" hidden>
          <div class="dots" id="dots" aria-live="polite" aria-label="PIN"></div>
          <div class="pad" id="pad" style="margin-top:14px">
            <button type="button" data-k="1">1</button><button type="button" data-k="2">2</button><button type="button" data-k="3">3</button>
            <button type="button" data-k="4">4</button><button type="button" data-k="5">5</button><button type="button" data-k="6">6</button>
            <button type="button" data-k="7">7</button><button type="button" data-k="8">8</button><button type="button" data-k="9">9</button>
            <button type="button" class="fn" data-k="clr" >{{ button_clear }}</button><button type="button" data-k="0">0</button><button type="button" class="fn" data-k="del" aria-label="{{ text_backspace|e }}"><i class="bi bi-backspace"></i></button>
          </div>
        </div>

        <div id="termBox" hidden>
          <p class="sub" style="margin:0 0 10px">{{ text_choose_terminal }}</p>
          <div class="tlist" id="termList"></div>
        </div>

        <div class="err-box" id="err" role="alert" hidden><i class="bi bi-exclamation-circle"></i><span id="errTxt"></span></div>

        <div class="row">
          <label class="chk"><input type="checkbox" id="rem"><span>{{ text_remember }}</span></label>
          <button type="button" class="link" id="forgot">{{ text_forgot }}</button>
        </div>

        <button class="btn pri" id="go" type="submit"><span id="goTxt">{{ text_sign_in }}</span></button>

        <div class="foot"><span>v{{ version|e }}</span><span>Bariklabs</span></div>
      </form>
  </div>
</div>
<div class="toast" id="toast" role="status" hidden></div>
<script type="application/json" id="bpos-login-data">{{ login_json }}</script>
<script src="{{ script|e }}"></script>
</body>
</html>
