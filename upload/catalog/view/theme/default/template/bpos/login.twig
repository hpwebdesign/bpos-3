      <path d="M690 666 H870 V662 Q870 640 848 640 H712 Q690 640 690 662 Z" fill="#D5DDFB"/>
      <circle cx="780" cy="698" r="28" fill="#3558D6"/><text x="780" y="710" text-anchor="middle" class="sgn" font-size="34" fill="#fff">B</text>
      <rect x="696" y="726" width="168" height="22" rx="11" fill="#7B86C6"/>
      <circle cx="868" cy="734" r="5" fill="#FFF1C4" filter="url(#glow)"/>
      <rect x="684" y="716" width="6" height="12" rx="2" fill="#D98A7A" class="tail"/>
    </g>
    <g class="wh"><circle cx="722" cy="766" r="19" fill="#090c26"/><circle cx="722" cy="766" r="9" fill="#3b4180"/><path d="M714 766 H730 M722 758 V774" stroke="#7680d0" stroke-width="2.5"/></g>
    <g class="wh"><circle cx="780" cy="766" r="19" fill="#090c26"/><circle cx="780" cy="766" r="9" fill="#3b4180"/><path d="M772 766 H788 M780 758 V774" stroke="#7680d0" stroke-width="2.5"/></g>
