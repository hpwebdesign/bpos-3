<div class="page mg" id="rp-root" data-title="{{ title|e }}" data-page="reports">
  <link rel="stylesheet" href="{{ style|e }}">

  <div class="ph">
    <div>
      <h1>{{ heading_reports|e }}</h1>
      <p>{{ scope|e }}</p>
    </div>
    <div class="phr">
      {% if can_export %}<button class="btn" id="rp-export" type="button"><i class="bi bi-download"></i><span>{{ button_export|e }}</span></button>{% endif %}
    </div>
  </div>

  <div class="cats kp" id="rp-kpis" aria-live="polite"></div>

  <div class="mg-bar">
    <div class="mg-seg" id="rp-range" role="group" aria-label="{{ text_range|e }}">
      <button type="button" data-range="today">{{ text_range_today|e }}</button>
      <button type="button" data-range="7" class="on">{{ text_range_7|e }}</button>
      <button type="button" data-range="30">{{ text_range_30|e }}</button>
      <button type="button" data-range="month">{{ text_range_month|e }}</button>
      <button type="button" data-range="custom">{{ text_range_custom|e }}</button>
    </div>
    <span class="mg-dates" id="rp-dates" hidden>
      <input class="mg-date" type="date" id="rp-from" aria-label="{{ text_date_from|e }}">
      <span>–</span>
      <input class="mg-date" type="date" id="rp-to" aria-label="{{ text_date_to|e }}">
    </span>
    <span class="rp-range-text" id="rp-rt"></span>
  </div>

  <div class="rp-body" id="rp-body" aria-live="polite">
    <section class="rp-card"><h3 class="rp-h">{{ text_daily_sales|e }}</h3><div id="rp-chart"></div></section>
    <div class="rp-two">
      <section class="rp-card"><h3 class="rp-h">{{ text_payment_mix|e }}</h3><div id="rp-pay"></div></section>
      <section class="rp-card"><h3 class="rp-h">{{ text_by_terminal|e }}</h3><div class="mg-scroll"><table class="mg-t" id="rp-term"></table></div></section>
    </div>
    <section class="rp-card"><h3 class="rp-h">{{ text_by_cashier|e }}</h3><div class="mg-scroll"><table class="mg-t" id="rp-cash"></table></div></section>
  </div>

  <script type="application/json" id="rp-data">{{ page_json }}</script>
  <script src="{{ script|e }}" data-bp-page></script>
</div>
