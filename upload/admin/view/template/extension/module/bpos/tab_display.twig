{{ dev_bar }}
{% for t in terminals %}
<div class="bps-dev" data-bps-dev="{{ t.terminal_id|e('html_attr') }}">
  <div class="bps-card">
    <div class="bps-card-h"><h3>{{ text_product_layout|e }}</h3><span class="bps-scope bps-scope-dev"><i class="fa fa-desktop"></i> {{ text_scope_device|e }}</span></div>
    <div class="bps-lc-wrap">
      <label class="bps-lc"><input type="radio" data-bps-field name="terminal[{{ t.terminal_id }}][layout]" value="compact"{% if t.opt.layout == 'compact' %} checked{% endif %}>
        <span class="bps-lc-in"><span class="bps-mini bps-mini-cmp"><i></i><i></i><i></i><i></i></span><b>{{ text_layout_compact|e }}</b><small>{{ help_layout_compact|e }}</small></span></label>
      <label class="bps-lc"><input type="radio" data-bps-field name="terminal[{{ t.terminal_id }}][layout]" value="gallery"{% if t.opt.layout == 'gallery' %} checked{% endif %}>
        <span class="bps-lc-in"><span class="bps-mini bps-mini-gal"><i></i><i></i><i></i></span><b>{{ text_layout_gallery|e }}</b><small>{{ help_layout_gallery|e }}</small></span></label>
    </div>
  </div>
</div>
{% endfor %}

<div class="bps-card">
  <div class="bps-card-h"><h3>{{ text_background|e }}</h3><span class="bps-scope"><i class="fa fa-globe"></i> {{ text_scope_all|e }}</span></div>
  <p class="bps-note">{{ help_background|e }}</p>
  {% set bgdef = {'l': {'base': '#EEF2FC', 'g1': '#D6E1FF', 'g2': '#EADFFF'}, 'd': {'base': '#0A1022', 'g1': '#14275A', 'g2': '#261B55'}} %}
  {% for m, title in {'l': text_bg_light, 'd': text_bg_dark} %}
  <div class="bps-bgh"><b>{{ title|e }}</b><button type="button" class="btn btn-default btn-sm" data-bps-bgreset="{{ m }}">{{ button_bg_reset|e }}</button></div>
  {% for p, label in {'base': entry_bg_base, 'g1': entry_bg_g1, 'g2': entry_bg_g2} %}
  {% set key = 'module_bpos_bg_' ~ m ~ '_' ~ p %}
  {% set val = attribute(settings, key) %}
  <div class="bps-row">
    <div class="bps-row-l"><b>{{ label|e }}</b></div>
    <div class="bps-row-r">
      <div class="bps-color" data-m="{{ m }}" data-p="{{ p }}">
        <input type="color" class="bps-cp" value="{{ (val ?: bgdef[m][p])|lower|e('html_attr') }}" data-def="{{ bgdef[m][p] }}" aria-label="{{ label|e('html_attr') }}">
        <input type="text" class="form-control" data-bps-field name="{{ key }}" maxlength="7" value="{{ val|e('html_attr') }}" placeholder="{{ bgdef[m][p] }}" autocomplete="off" spellcheck="false">
      </div>
      <div class="bps-err" data-bps-err="{{ key }}"></div>
    </div>
  </div>
  {% endfor %}
  <div class="bps-bgpv" data-bps-bgpv="{{ m }}"></div>
  {% endfor %}
</div>
