<div class="bps-card">
  <div class="bps-card-h"><h3>{{ text_terminal|e }}</h3></div>
  <div class="bps-row">
    <div class="bps-row-l"><b>{{ entry_status|e }}</b><small>{{ help_status|e }}</small></div>
    <div class="bps-row-r">
      <label class="bps-sw"><input type="checkbox" data-bps-field name="module_bpos_status" value="1"{% if settings.module_bpos_status %} checked{% endif %}><span></span></label>
    </div>
  </div>
  <div class="bps-row">
    <div class="bps-row-l"><b>{{ entry_lang|e }}</b></div>
    <div class="bps-row-r">
      <select class="form-control" data-bps-field name="module_bpos_lang">
        <option value="">{{ text_use_store_default|e }}</option>
        {% for code, language in languages %}
        <option value="{{ code|e('html_attr') }}"{% if settings.module_bpos_lang == code %} selected{% endif %}>{{ language.name|e }}</option>
        {% endfor %}
      </select>
      <div class="bps-err" data-bps-err="module_bpos_lang"></div>
    </div>
  </div>
  <div class="bps-row">
    <div class="bps-row-l"><b>{{ entry_currency|e }}</b></div>
    <div class="bps-row-r">
      <select class="form-control" data-bps-field name="module_bpos_currency">
        <option value="">{{ text_use_store_default|e }}</option>
        {% for code, currency in currencies %}
        <option value="{{ code|e('html_attr') }}"{% if settings.module_bpos_currency == code %} selected{% endif %}>{{ currency.title|e }} ({{ code|e }})</option>
        {% endfor %}
      </select>
      <div class="bps-err" data-bps-err="module_bpos_currency"></div>
    </div>
  </div>
  <div class="bps-row">
    <div class="bps-row-l"><b>{{ entry_currency_switch|e }}</b><small>{{ help_currency_switch|e }}</small></div>
    <div class="bps-row-r">
      <label class="bps-sw"><input type="checkbox" data-bps-field name="module_bpos_currency_switch" value="1"{% if settings.module_bpos_currency_switch %} checked{% endif %}><span></span></label>
    </div>
  </div>
</div>

<div class="bps-card">
  <div class="bps-card-h"><h3>{{ text_customers|e }}</h3></div>
  <div class="bps-row">
    <div class="bps-row-l"><b>{{ entry_guest|e }}</b><small>{{ help_guest|e }}</small></div>
    <div class="bps-row-r">
      <label class="bps-sw"><input type="checkbox" data-bps-field name="module_bpos_guest" value="1"{% if settings.module_bpos_guest %} checked{% endif %}><span></span></label>
    </div>
  </div>
</div>
